# MongoDB
# Local MongoDB for development. You can also use a remote Atlas URI here.
DATABASE_URL="mongodb://127.0.0.1:27017/devorbit"

# The backend also accepts MONGODB_URI or MONGO_URL in hosted environments.

# JWT
JWT_SECRET=changemeverywhere
JWT_EXPIRY=7d

# Frontend base URL used in email links
FRONTEND_URL=http://127.0.0.1:3000

# Email (SMTP) - optional; fallback is console log
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Code runner service
CODE_RUNNER_URL=http://127.0.0.1:3000
RUNNER_TIMEOUT_MS=45000

# Redis (for queue)
REDIS_URL=redis://127.0.0.1:6379
EXECUTION_QUEUE_ENABLED=true
EXECUTION_QUEUE_CONCURRENCY=10
EXECUTION_QUEUE_PROCESS_IN_APP=true
EXECUTION_QUEUE_LOCAL_FALLBACK=true
EXECUTION_QUEUE_DIRECT_FALLBACK=true
EXECUTION_QUEUE_ATTEMPTS=2
EXECUTION_QUEUE_JOB_TIMEOUT_MS=60000
EXECUTION_QUEUE_RESULT_TIMEOUT_MS=600000

# Admin Credentials Config
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Execution limits
EXECUTION_TIMEOUT_MS=5000
EXECUTION_MEMORY_MB=256

# Judge0 (code execution)
# Leave all empty to use the free public server (https://ce.judge0.com).
# For RapidAPI: set only JUDGE0_RAPIDAPI_KEY; the URL and host are filled in automatically.
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
# For a self-hosted Judge0: set JUDGE0_URL (and JUDGE0_AUTH_TOKEN if you enabled auth).
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
